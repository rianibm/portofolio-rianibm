---
import type { CollectionEntry } from "astro:content";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { Icon } from "astro-icon/components";
import { getSkillClass as _getSkillClass } from "@/utils/helpers";

type Props = CollectionEntry<"works">["data"] & {
  id?: string;
  pageSkills?: Array<{
    category: string;
    icon: string;
    skills: string[];
  }>;
};

const {
  id,
  title = "",
  description,
  pubDate,
  updatedDate,
  heroImage,
  icon,
  tags,
  role,
  pageSkills,
} = Astro.props;

// Import collections and images
import { getCollection } from "astro:content";
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const posts = (await getCollection("works")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const bgClasses = [
  "hover:shadow-ppinkHover",
  "hover:shadow-pgreenHover",
  "hover:shadow-pblueHover",
  "hover:shadow-pyellowHover",
];

const skillBgClasses = [
  "bg-pgreen rounded-xl",
  "bg-pblue rounded-xl",
  "bg-ppink rounded-xl",
  "bg-pyellow rounded-xl",
];

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif}')
if (heroImage && !images[heroImage]) throw new Error(`"${heroImage}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif}"`);

const getBgClass = (i: number) => _getSkillClass(i, bgClasses);

const getSkillBgClass = (i: number) => _getSkillClass(i, skillBgClasses);

const relevantSkills = pageSkills ?? [];
---

<html lang="en">
    <head>
    <BaseHead title={title} description={description} />

    <!-- SEO -->
    <meta name="keywords" content="Rianibm, Riani BM, UX Engineer, Frontend Developer, Portfolio, React, Laravel, Tailwind, UI/UX" />
    <meta name="author" content="Rianibm" />
    <meta name="google-site-verification" content="RCc1MVKPhX5dC6D2cAtvSUNTKVPZemBb-O5jEo7czuY" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title ? `${title} | Rianibm` : "Rianibm - UX Engineer & Frontend Developer"} />
    <meta property="og:description" content={description ?? "Portofolio of Rianibm. UX Engineer & Frontend Developer based in Jakarta, Indonesia."} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rianibm.com/" />
    <meta property="og:image" content="https://rianibm.com/thumbnail.jpg" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? `${title} | Rianibm` : "Rianibm - UX Engineer & Frontend Developer"} />
    <meta name="twitter:description" content={description ?? "Portofolio resmi Rianibm. UX Engineer & Frontend Developer dari Indonesia."} />
    <meta name="twitter:image" content="https://rianibm.com/thumbnail.jpg" />

    <!-- Schema.org JSON-LD (Google Rich Results) -->
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Riani BM",
        "alternateName": "Rianibm",
        "url": "https://rianibm.com",
        "jobTitle": "UX Engineer & Frontend Developer",
        "sameAs": [
          "https://www.linkedin.com/in/rianibm",
          "https://github.com/rianibm"
        ]
      })}
    </script>
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1" class="mx-auto max-w-6xl px-6 md:px-10 text-white">
      <a
        href="/works"
        aria-label="Go back to works"
        class="inline-block px-6 py-3 bg-pgreen text-black rounded-lg font-semibold text-sm hover:shadow-hover transition-all duration-200 border border-black mb-4"
      >
        Back to Works
      </a>
      <article>
        <div class="relative mb-12 overflow-hidden" transition:animate="fade">
          {heroImage ? (
            <>
              <span class="bg-black bg-opacity-25 w-full h-full absolute"></span>
              <Image src={images[heroImage]()} alt={title} class="h-72 md:h-80 w-full object-cover"/>
            </>
          ) : (
            <div class="h-72 md:h-80 w-full bg-pblack flex items-center justify-end overflow-hidden">
              <Icon name={icon} class="text-[16rem] text-white/10 -mr-10" aria-hidden="true" />
            </div>
          )}
          <div class="absolute bottom-10 md:left-20 left-6 right-6 md:right-20">
            <h1 class="text-3xl sm:text-4xl md:text-8xl font-semibold text-shadow leading-tight">
              <span class="font-kablamo text-ppink leading-none inline-block">{title.charAt(0)}</span>{
                title.slice(1)
              }
            </h1>
            {role && <p class="text-xs md:text-sm font-semibold uppercase tracking-wide text-white/70 mb-1">{role}</p>}
            <p>{description}</p>
          </div>
        </div>
        <div class="text-black max-w-3xl mx-auto">
          <div class="">
            <div class="text-sm text-pblack flex items-center justify-between">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
              <Icon name={icon} class="text-5xl" transition:animate="fade" aria-hidden="true" />
            </div>
            <hr />
          </div>
          <div
            id="blog-section-label"
            class="hidden md:block sticky top-[4.5rem] z-20 bg-white/80 backdrop-blur-sm py-1.5 text-[11px] text-black/40 tracking-widest font-normal uppercase transition-opacity duration-300 opacity-0 pointer-events-none"
            aria-hidden="true"
          >
            <span id="blog-section-label-text"></span>
          </div>
          <div class="flex flex-col gap-10 py-10">
            <div class="prose max-w-none prose-h2:mt-16 prose-h2:scroll-mt-28 prose-h3:mt-10 prose-h3:scroll-mt-28 prose-p:my-4 prose-ul:my-4 prose-img:my-6 prose-table:my-6">
              <slot />
            </div>
            <div class="flex flex-col gap-6" transition:animate="slide">
              <!-- Related Skills Section -->
              <div class="flex flex-col gap-4 pt-10 md:pt-0">
                <p class="md:hidden font-semibold">Related Skills:</p>
                <h3 class="hidden md:block text-lg font-semibold mb-2">Technologies Used</h3>
                <div class="flex flex-col gap-3">
                  {relevantSkills.map((skillGroup, i) => {
                    const skillClass = getSkillBgClass(i);
                    return (
                      <div class="border border-black rounded-lg p-3 shadow-card hover:shadow-hover transition-all duration-200">
                        <div class="flex items-center gap-2 mb-2">
                          <div class={`${skillClass} p-1 border border-black shadow-card1 text-sm`}>
                            <Icon name={skillGroup.icon} aria-hidden="true" />
                          </div>
                          <h4 class="font-semibold text-sm">{skillGroup.category}</h4>
                        </div>
                        <div class="flex flex-wrap gap-1">
                          {skillGroup.skills.map((skill: string) => (
                            <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded-full text-xs border border-gray-300">
                              {skill}
                            </span>
                          ))}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>      
              
              <hr />
              
              <!-- Related Posts (smaller section) -->
              <div class="flex flex-col gap-2">
                <p class="font-semibold text-sm">More Posts:</p>
                <ul class="flex flex-col gap-1">
                  {
                    posts.filter((post) => post.id !== id).slice(0, 3).map((post, i) => {
                      return (
                        <li class={`text-left rounded-md border-1 border-black shadow-card group hover:shadow-hover transition px-2 py-1 text-sm ${getBgClass(i)}`}>
                          <a href={`/works/${post.id}/`}>
                            <h5 class="text-xs font-medium">{post.data.title}</h5>
                          </a>
                        </li>
                      );
                    })
                  }
                </ul>
              </div>
              
              <hr />
              <p>Portfolio of</p>
              <div class="flex -mt-4 gap-2">
                <div class="bg-pgreen rounded-full w-12 h-12 aspect-square object-contain overflow-hidden">
                  <Image src={images["/src/assets/rianibm-removebg-preview.png"]()} alt="Riani BM" />
                </div>
                <div>
                  <h3>Riani BM</h3>
                  <p class="text-pblack">UX Engineer<br>from Indonesia</p>
                </div>
              </div>
              <hr/>
              <div>
                <p>Links:</p>
                <div class="flex items-center gap-6 text-xl">
                  <a
                    href="mailto:rianimatialu@gmail.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Email Riani BM"
                    class="py-1 pl-3 rounded-md border-1 border-black bg-ppink shadow-card hover:shadow-hover transition"
                  >
                    <Icon name="web" aria-hidden="true" />
                  </a>
                  <a
                    href="https://github.com/rianibm"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="GitHub Riani BM"
                    class="border-1 p-1 border-black rounded-full bg-pblue shadow-card hover:shadow-hover transition"
                  >
                    <Icon name="github" aria-hidden="true" />
                  </a>
                  <a
                    href="https://www.linkedin.com/in/rianibm/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn Riani BM"
                    class="border-1 p-1 border-black rounded-full bg-pgreen shadow-card hover:shadow-hover transition"
                  >
                    <Icon name="linkedin" aria-hidden="true" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </main>
    <Footer />
    <script>
      function initBlogSectionLabel() {
        const label = document.getElementById("blog-section-label") as HTMLElement | null;
        const labelText = document.getElementById("blog-section-label-text") as HTMLElement | null;
        const headings = document.querySelectorAll<HTMLElement>(".prose h2");

        if (!label || !labelText || headings.length === 0) return;

        const _label = label;
        const _labelText = labelText;

        let currentSection = "";
        function onScroll() {
          let active = "";
          var triggerLine = _label.getBoundingClientRect().bottom;
          headings.forEach((h) => {
            if (h.getBoundingClientRect().top <= triggerLine) {
              active = h.textContent?.trim() || "";
            }
          });

          if (active && active !== currentSection) {
            currentSection = active;
            _labelText.textContent = "Section \u2014 " + active;
            _label.classList.remove("opacity-0");
            _label.classList.add("opacity-100");
          } else if (!active && currentSection) {
            currentSection = "";
            _label.classList.remove("opacity-100");
            _label.classList.add("opacity-0");
          }
        }

        window.addEventListener("scroll", onScroll, { passive: true });
      }

      initBlogSectionLabel();
      document.addEventListener("astro:after-swap", initBlogSectionLabel);

      function initImageLightbox() {
        let overlay = document.getElementById("img-lightbox") as HTMLDivElement | null;

        if (!overlay) {
          overlay = document.createElement("div");
          overlay.id = "img-lightbox";
          overlay.className = "img-lightbox";
          overlay.innerHTML =
            '<button type="button" class="img-lightbox-close" aria-label="Close image preview">&times;</button>' +
            '<img class="img-lightbox-img" src="" alt="" />';
          document.body.appendChild(overlay);

          const closeLightbox = () => {
            overlay!.classList.remove("is-open");
            document.body.style.overflow = "";
          };

          overlay.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (target === overlay || target.classList.contains("img-lightbox-close")) {
              closeLightbox();
            }
          });

          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeLightbox();
          });
        }

        const imgEl = overlay.querySelector(".img-lightbox-img") as HTMLImageElement;
        const _overlay = overlay;

        document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
          if (img.dataset.lightboxBound) return;
          img.dataset.lightboxBound = "true";
          img.classList.add("img-lightbox-trigger");
          img.addEventListener("click", () => {
            imgEl.src = img.currentSrc || img.src;
            imgEl.alt = img.alt || "";
            _overlay.classList.add("is-open");
            document.body.style.overflow = "hidden";
          });
        });
      }

      initImageLightbox();
      document.addEventListener("astro:after-swap", initImageLightbox);
    </script>
    <style>
      .prose :global(table) {
        width: 100%;
      }
      .prose :global(table:has(img)) {
        table-layout: fixed;
      }
      .prose :global(table:not(:has(img))) {
        table-layout: auto;
      }
      .prose :global(table img) {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: contain;
        object-position: top center;
        background: #f4f4f5;
        border-radius: 0.5rem;
        display: block;
        margin: 0;
      }
      .prose :global(td) {
        vertical-align: top;
      }
      .prose :global(table:not(:has(img)) th),
      .prose :global(table:not(:has(img)) td) {
        padding: 0.6rem 0.75rem;
      }
      .prose :global(table:not(:has(img)) tbody tr:nth-child(even)) {
        background: rgba(0, 0, 0, 0.025);
      }
      @media (max-width: 767px) {
        .prose :global(table:has(img)) {
          display: block;
        }
        .prose :global(table:has(img) thead) {
          display: none;
        }
        .prose :global(table:has(img) tbody) {
          display: block;
        }
        .prose :global(table:has(img) tr) {
          display: block;
          margin-bottom: 1.5rem;
        }
        .prose :global(table:has(img) tr:last-child) {
          margin-bottom: 0;
        }
        .prose :global(table:has(img) td) {
          display: block;
          width: 100% !important;
          padding: 0;
        }
        .prose :global(table:has(img) td:first-child) {
          margin-bottom: 1rem;
        }
        .prose :global(table:has(img) td:first-child)::before,
        .prose :global(table:has(img) td:nth-child(2))::before {
          display: block;
          font-size: 0.6875rem;
          font-weight: 600;
          text-transform: uppercase;
          letter-spacing: 0.06em;
          color: rgba(0, 0, 0, 0.45);
          margin-bottom: 0.375rem;
        }
        .prose :global(table:has(img) td:first-child)::before {
          content: "Before";
        }
        .prose :global(table:has(img) td:nth-child(2))::before {
          content: "After";
        }
      }
      .prose :global(hr) {
        margin: 3.5rem 0;
        border: none;
        border-top: 2px solid #e5e5e5;
      }
      .prose :global(h2 + h3),
      .prose :global(h2 + p) {
        margin-top: 0.75rem !important;
      }
      .prose :global(.img-lightbox-trigger) {
        cursor: zoom-in;
      }
    </style>
    <style is:global>
      .img-lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.85);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
      }
      .img-lightbox.is-open {
        opacity: 1;
        pointer-events: auto;
      }
      .img-lightbox-img {
        max-width: min(100%, 900px);
        max-height: 75vh;
        border-radius: 0.5rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        cursor: default;
      }
      .img-lightbox-close {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 9999px;
        border: none;
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        font-size: 1.75rem;
        line-height: 1;
        cursor: pointer;
      }
      .img-lightbox-close:hover {
        background: rgba(255, 255, 255, 0.3);
      }
    </style>
  </body>
</html>