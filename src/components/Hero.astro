---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif}",
);

---

<section class="py-20 flex md:flex-row flex-col gap-10 md:gap-0">
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <p class="text-pblack hero-entrance" style="--delay: 0s">Riani BM</p>
    <h1 class="text-6xl font-bold hero-entrance" style="--delay: 0.1s">
      UX Engineer
    </h1>
    <p class="hero-entrance" style="--delay: 0.2s">
      I design and build production-ready experiences across complex workflows, combining UX architecture, interaction design, and frontend engineering.
    </p>
    <p class="text-xs md:text-sm font-semibold uppercase tracking-widest text-pblack/60 hero-entrance" style="--delay: 0.25s">
      UX Architecture · Interaction Design · UI Systems · Frontend Implementation
    </p>
    <a
      href="#selected-work"
      aria-label="View selected work"
      class="bg-pgreen px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition hero-entrance settle"
      style="--delay: 0.3s"
    >
      View Selected Work →
    </a>
  </div>
  <div
    class="md:w-1/2 object-contain flex items-center justify-center p-10 group hero-entrance from-right"
    style="--delay: 0.2s"
  >
    <a
      rel="noopener noreferrer"
      href="https://www.linkedin.com/in/rianibm/"
      target="_blank"
      aria-label="LinkedIn Riani BM"
    >
      <div
        class="bg-pblue border-3 border-black rounded-2xl h-52 w-60 shadow-card group-hover:shadow-hover flex transition relative settle"
      >
        <div
          class="absolute text-nowrap flex items-center gap-2 -bottom-5 right-4 px-4 py-1.5 bg-pgreen z-10 shadow-card1 group-hover:shadow-card transition rounded-full border-3 border-black hero-entrance scale-in text-sm font-semibold"
          style="--delay: 0.5s"
        >
          <Icon name="linkedin" aria-hidden="true" />
          <p>Connect on LinkedIn</p>
        </div>
        <div class="h-80 w-60 overflow-hidden relative -mt-30 rounded-2xl">
          <Image
            class="object-bottom absolute bottom-0 group-hover:scale-105 transition"
            src={images["/src/assets/rianibm-removebg-preview.png"]()}
            alt="Riani BM"
          />
        </div>
      </div></a
    >
  </div>
</section>
