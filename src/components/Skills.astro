---
const skillGroups = [
  {
    category: "UX & Product",
    bg: "bg-pgreen rounded-full",
    skills: [
      "UX Architecture",
      "Interaction Design",
      "Information Architecture",
      "UI Systems",
      "Accessibility",
      "Usability Evaluation",
    ],
  },
  {
    category: "Engineering",
    bg: "bg-pblue rounded-2xl",
    skills: ["React", "Next.js", "TypeScript", "JavaScript", "Tailwind CSS", "Laravel"],
  },
  {
    category: "Tools",
    bg: "bg-ppink",
    skills: ["Figma", "Hotjar", "Git"],
  },
];
---

<section class="flex flex-col text-center gap-8 py-20">
  <div class="flex flex-col gap-4 animate-on-scroll from-bottom">
    <p class="text-pblack">What I bring to a product team:</p>
    <h2 class="text-2xl md:text-4xl font-bold">Skills</h2>
  </div>

  <div class="flex flex-col gap-8 max-w-3xl mx-auto w-full">
    {skillGroups.map((group, gi) => (
      <div class="flex flex-col gap-3 text-left animate-on-scroll from-bottom" style={`--delay: ${gi * 0.1}s`}>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-pblack/60">{group.category}</h3>
        <div class="flex flex-wrap gap-2">
          {group.skills.map((skill) => (
            <span class={`${group.bg} px-3 py-1.5 border-1 border-black shadow-card1 hover:shadow-card transition text-sm font-medium`}>
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
