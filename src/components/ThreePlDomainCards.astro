---
import { Icon } from "astro-icon/components";

const shipments = [
  {
    label: "Darat",
    title: "Land Shipment",
    icon: "solar:delivery-linear",
    features: ["More linear workflow", "Fewer status transitions", "Complete operational data expected earlier"],
    flowLabel: "Operational flow",
    steps: [
      { label: "Shipment recorded", icon: "solar:document-text-linear" },
      { label: "In transit", icon: "solar:delivery-linear" },
      { label: "Completed", icon: "solar:check-circle-linear" },
    ],
  },
  {
    label: "Udara",
    title: "Air Shipment",
    icon: "solar:plane-linear",
    features: ["Multi-stage shipment workflow", "Flight data may initially be incomplete", "Status actions depend on the current stage"],
    flowLabel: "Shipment progression",
    steps: [
      { label: "Arrival recorded", icon: "solar:map-point-linear" },
      { label: "Transit information updated", icon: "solar:plane-linear" },
      { label: "Delivery evidence confirmed", icon: "solar:document-text-linear" },
    ],
  },
];
---

<div class="domain-comparison not-prose">
  <div class="shipment-grid">
    {shipments.map((shipment) => (
      <section class="shipment-card" aria-labelledby={`shipment-${shipment.label.toLowerCase()}`}>
        <div class="card-heading">
          <span class="hero-icon" aria-hidden="true"><Icon name={shipment.icon} width={44} height={44} /></span>
          <div class="heading-copy">
            <p class="eyebrow">{shipment.label}</p>
            <h3 id={`shipment-${shipment.label.toLowerCase()}`}>{shipment.title}</h3>
          </div>
        </div>
        <ul class="feature-list">
          {shipment.features.map((feature) => (
            <li><span class="check-icon" aria-hidden="true"><Icon name="solar:check-linear" width={18} height={18} /></span><span>{feature}</span></li>
          ))}
        </ul>
        <div class="workflow">
          <h4 class="eyebrow">{shipment.flowLabel}</h4>
          <ol class="flow-steps">
            {shipment.steps.map((step, index) => (
              <li>
                <div class="flow-step">
                  <span class="step-icon" aria-hidden="true"><Icon name={step.icon} width={26} height={26} /></span>
                  <span>{step.label}</span>
                </div>
                {index < shipment.steps.length - 1 && <Icon name="solar:arrow-right-linear" class="flow-arrow" width={20} height={20} aria-hidden="true" />}
              </li>
            ))}
          </ol>
        </div>
      </section>
    ))}
    <aside class="design-implication" aria-labelledby="domain-design-implication">
      <span class="hero-icon" aria-hidden="true"><Icon name="solar:lightbulb-linear" width={40} height={40} /></span>
      <div class="heading-copy">
        <h3 id="domain-design-implication" class="eyebrow">Design implication</h3>
        <p>Land and air shipments use separate workflows because their steps and information needs differ.</p>
      </div>
    </aside>
  </div>
</div>

<style>
  .domain-comparison { --blue: #0075b8; --border: #cbeafb; margin-block: 2rem; }
  .shipment-grid { display: grid; gap: 1rem; }
  .shipment-card { display: flex; flex-direction: column; padding: 1.5rem; border: 1px solid var(--border); border-radius: 1rem; background: #f5fbff; }
  .card-heading { display: flex; align-items: center; gap: 1.25rem; }
  .hero-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 5rem; height: 5rem; border-radius: 50%; background: #e1f3fd; color: var(--blue); }
  .heading-copy { border-left: 1px solid var(--border); padding-left: 1.25rem; min-width: 0; }
  .eyebrow { margin: 0; color: var(--blue); font-size: 0.75rem; font-weight: 800; line-height: 1.5; letter-spacing: 0.065em; text-transform: uppercase; }
  h3:not(.eyebrow) { margin: 0.25rem 0 0; color: #101828; font-size: 1.75rem; font-weight: 750; line-height: 1.25; }
  .feature-list { display: grid; gap: 0.875rem; padding: 0; margin: 1.75rem 0; list-style: none; }
  .feature-list li { display: flex; align-items: flex-start; gap: 0.75rem; color: #596579; font-size: 0.9375rem; line-height: 1.6; }
  .check-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 1.5rem; height: 1.5rem; background: #d9f0fd; color: var(--blue); border-radius: 50%; }
  .workflow { border-top: 1px solid var(--border); padding-top: 1.25rem; margin-top: auto; }
  .flow-steps { display: flex; padding: 0; margin: 0.875rem 0 0; list-style: none; gap: 0.375rem; }
  .flow-steps li { display: flex; align-items: center; flex: 1 1 0; min-width: 0; gap: 0.375rem; }
  .flow-steps li:last-child { flex-grow: 0; flex-basis: calc((100% - 3.75rem) / 3); }
  .flow-step { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 0.5rem; flex: 1; align-self: stretch; padding: 0.75rem 0.375rem; min-width: 0; border: 1px solid #b6e2fa; border-radius: 0.75rem; color: #17243d; font-size: 0.75rem; font-weight: 650; line-height: 1.4; text-align: left; }
  .step-icon { display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: #e1f3fd; color: var(--blue); }
  .flow-arrow { flex-shrink: 0; color: var(--blue); }
  .design-implication { display: flex; align-items: center; gap: 1.25rem; padding: 1.25rem 1.5rem; border: 1px solid var(--border); border-radius: 1rem; background: white; }
  .design-implication p { margin: 0.5rem 0 0; color: #101828; font-size: 1.0625rem; font-weight: 650; line-height: 1.5; }
  @media (min-width: 1024px) {
    .domain-comparison { width: min(calc(100vw - 5rem), 67rem); margin-left: 0; }
    .shipment-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .design-implication { grid-column: 1 / -1; }
  }
  @media (max-width: 479px) {
    .shipment-card, .design-implication { padding: 1rem; }
    .card-heading, .design-implication { gap: 0.875rem; }
    .hero-icon { width: 3.5rem; height: 3.5rem; }
    .hero-icon :global(svg) { width: 2rem; height: 2rem; }
    .heading-copy { padding-left: 0.875rem; }
    h3:not(.eyebrow) { font-size: 1.375rem; }
    .flow-steps { flex-direction: column; gap: 0.5rem; }
    .flow-steps li { flex-direction: column; gap: 0.5rem; }
    .flow-steps li:last-child { flex-basis: auto; }
    .flow-step { flex-direction: row; justify-content: flex-start; padding: 0.625rem; text-align: left; }
    .flow-arrow { transform: rotate(90deg); }
    .design-implication { align-items: flex-start; }
    .design-implication p { font-size: 0.9375rem; }
  }
</style>
