---
import { Icon } from "astro-icon/components";
interface Props { href: string; label: string; domain: string }
const { href, label, domain } = Astro.props;
---

<div class="project-link-wrap not-prose">
  <a class="project-link" href={href} target="_blank" rel="noopener noreferrer">
    <span class="site-icon" aria-hidden="true"><Icon name="heroicons:globe-alt" width={24} height={24} /></span>
    <span class="copy"><span class="label">{label}</span><span class="domain">{domain}</span></span>
    <span class="arrow" aria-hidden="true"><Icon name="heroicons:arrow-up-right" width={22} height={22} /></span>
    <span class="sr-only"> (opens in a new tab)</span>
  </a>
</div>

<style>
  .project-link-wrap { margin: 1.5rem 0 2rem; }
  .project-link { display: inline-flex; align-items: center; gap: 1rem; max-width: 100%; padding: 1rem 1.25rem; border: 1px solid #17243d; border-radius: 1rem; background: var(--color-pgreen, #d9f99d); color: #17243d; box-shadow: 4px 4px 0 #17243d; text-decoration: none; transition: transform 180ms ease, box-shadow 180ms ease; }
  .site-icon { display: grid; place-items: center; flex-shrink: 0; width: 2.75rem; height: 2.75rem; border: 1px solid #17243d; border-radius: 50%; background: #ffffff80; }
  .copy { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .label { font-size: .9375rem; font-weight: 750; line-height: 1.4; }
  .domain { font-size: .75rem; line-height: 1.5; overflow-wrap: anywhere; }
  .arrow { flex-shrink: 0; margin-left: .5rem; transition: transform 180ms ease; }
  .project-link:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 #17243d; }
  .project-link:hover .arrow { transform: translate(2px, -2px); }
  .project-link:focus-visible { outline: 3px solid #006ba8; outline-offset: 6px; }
  .project-link:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 #17243d; }
  @media (prefers-reduced-motion: reduce) { .project-link, .arrow { transition: none; transform: none !important; } }
  :global(.reduce-motion) .project-link, :global(.reduce-motion) .arrow { transition: none; transform: none !important; }
</style>
