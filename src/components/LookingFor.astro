---
import { Icon } from "astro-icon/components";
---

<section class="flex flex-col text-center gap-8 py-20">
  <div class="flex flex-col gap-4 animate-on-scroll from-bottom">
    <p class="text-pblack">Ready for new opportunities:</p>
    <h2 class="text-2xl md:text-4xl font-bold">What I'm Looking For</h2>
  </div>

  <div class="flex justify-center">
    <div class="max-w-3xl w-full animate-on-scroll from-bottom" style="--delay: 0.1s">
      <div class="bg-pyellow rounded-2xl border-1 border-black shadow-card hover:shadow-hover transition-all duration-300 p-6 md:p-8">
        <div class="flex items-start gap-4">
          <div class="bg-pgreen rounded-full p-3 border-1 border-black shadow-card1 flex-shrink-0 mt-1">
            <Icon name="5" class="text-2xl" aria-hidden="true" />
          </div>
          <div class="text-left flex-1">
            <p class="text-lg md:text-xl leading-relaxed text-black">
              I'm looking to join product teams solving complex user journeys at scale — especially across logistics, commerce, and operational systems where UX decisions and engineering constraints have to work together.
            </p>
            <div class="mt-6 flex flex-wrap gap-3 justify-center md:justify-start">
              <span class="px-3 py-1 bg-pblue rounded-full text-sm font-medium border-1 border-black animate-on-scroll scale-in" style="--delay: 0.2s">UX Engineering</span>
              <span class="px-3 py-1 bg-pgreen rounded-full text-sm font-medium border-1 border-black animate-on-scroll scale-in" style="--delay: 0.4s">Product Design</span>
              <span class="px-3 py-1 bg-white rounded-full text-sm font-medium border-1 border-black animate-on-scroll scale-in" style="--delay: 0.5s">Frontend</span>
            </div>
            <a
              href="mailto:rianimatialu@gmail.com"
              aria-label="Email Riani BM"
              class="inline-block mt-6 bg-pgreen px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition settle font-semibold"
            >
              Get in Touch →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>