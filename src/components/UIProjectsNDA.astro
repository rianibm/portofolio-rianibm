---
import { Icon } from "astro-icon/components";

const enterpriseProjects = [
  {
    icon: "3",
    title: "e-KTP Identity Management System",
    meta: "Desktop · Identity · Enterprise",
    description:
      "Designed the UX and UI for identity data input, verification, and administrative workflows in a desktop e-KTP identity system.",
    role: "UX Design · UI Design",
    focus: "Complex forms · Validation · Desktop workflows",
  },
  {
    icon: "4",
    title: "LRT Jakarta — Ticketing & Operations Dashboard",
    meta: "Web · Transportation · Operations",
    description:
      "Worked across LRT Jakarta 1B digital systems — web ticketing and an operational monitoring dashboard for passenger and operations teams.",
    role: "UI Design · Frontend Implementation",
    focus: "Web ticketing · Operational dashboard · Monitoring UI",
  },
  {
    icon: "5",
    title: "Telkomsel Perso Reporting Platform",
    meta: "Web · Reporting · Enterprise",
    description:
      "UI design for reporting interfaces covering operational data and internal workflows for Telkomsel Perso.",
    role: "UI Design",
    focus: "Reporting · Data-heavy UI · Information hierarchy",
  },
  {
    icon: "5",
    title: "Airline Catering Operations Management System",
    meta: "Web & Desktop · Operations",
    description:
      "UI design for web and desktop dashboards covering airline catering operations and workflow visualization.",
    role: "UI Design",
    focus: "Dashboard UI · Workflow visualization",
  },
  {
    icon: "1",
    title: "Event Ticketing Marketplace Platform",
    meta: "Web · Marketplace · Multi-role",
    description:
      "Multi-role interfaces for purchase flows, seller dashboards, and internal ops tools.",
    role: "UI Design",
    focus: "Multi-role interface design",
  },
  {
    icon: "2",
    title: "Race Event Ticketing & Validation System",
    meta: "Web · Real-time · On-site",
    description:
      "Ticket access, organizer views, and validator scanning flows for real-time, on-site use.",
    role: "UI Design",
    focus: "Real-time interface design",
  },
];

const bgClasses = [
  "bg-pgreen rounded-full",
  "bg-pblue rounded-2xl",
  "bg-ppink",
  "bg-pyellow rounded-md",
];
const getBgClass = (i: number) => bgClasses[i % bgClasses.length];
---

<section class="flex flex-col text-center gap-8 py-14">
  <div class="flex flex-col gap-4">
    <p class="text-pblack">Selected client and enterprise work across identity, transportation, operations, and ticketing platforms</p>
    <h2 class="section-heading scroll-mt-28 text-2xl md:text-4xl font-bold" data-section="Enterprise & Client Work">
      Enterprise & Client Work
    </h2>
  </div>

  <div class="flex justify-center">
    <div class="max-w-4xl w-full">
      <ul class="flex flex-col gap-4 text-left">
        {
          enterpriseProjects.map((project, i) => {
            const bgClass = getBgClass(i);
            return (
              <li class="border border-black rounded-lg p-4 shadow-card hover:shadow-hover transition-all duration-300">
                <div class="flex items-start gap-4">
                  <div
                    class={`${bgClass} p-2 border border-black shadow-card1 flex-shrink-0 mt-1`}
                  >
                    <Icon
                      name={project.icon}
                      class="text-lg"
                      aria-hidden="true"
                    />
                  </div>
                  <div class="flex-1">
                    <span class="text-[10px] font-semibold uppercase tracking-wide text-gray-400">
                      {project.meta}
                    </span>
                    <h3 class="text-lg font-semibold text-black mt-1 mb-2">
                      {project.title}
                    </h3>
                    <p class="text-sm text-gray-600 leading-relaxed">
                      {project.description}
                    </p>
                    <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">
                      Role: {project.role}
                    </p>
                    <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-400">
                      Focus: {project.focus}
                    </p>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
