---
import { Icon } from "astro-icon/components";
---

<section class="flex flex-col text-center gap-8 py-20">
  <div class="flex flex-col gap-4 animate-on-scroll from-bottom">
    <p class="text-pblack">My educational background:</p>
    <h2 class="text-2xl md:text-4xl ">Education</h2>
  </div>

  <div class="flex justify-center">
    <div class="max-w-2xl w-full animate-on-scroll from-bottom" style="--delay: 0.1s">
      <div class="bg-pgreen rounded-2xl border-1 border-black shadow-card hover:shadow-hover transition-all duration-300 p-6">
        <div class="flex items-start gap-3 text-left">
          <div class="bg-pyellow rounded-full p-2 border-1 border-black shadow-card1 flex-shrink-0 mt-1">
            <Icon name="1" class="text-xl" aria-hidden="true" />
          </div>
          <div>
            <h3 class="text-lg md:text-xl font-bold text-black">B.Sc. Informatics</h3>
            <p class="text-sm text-black opacity-80">Duta Wacana Christian University · GPA 3.62/4.00</p>
          </div>
        </div>

        <details class="mt-4 group">
          <summary class="cursor-pointer text-left text-sm font-semibold text-black underline underline-offset-4 list-none">
            Thesis: Inclusive Design for Website-Based Learning →
          </summary>
          <p class="text-sm text-black text-left leading-relaxed mt-3">
            Designed and coded an inclusive e-learning platform for users with contrast sensitivity, light sensitivity, low vision, and blindness. Conducted rapid ethnography and in-depth interviews; accessibility-tested with NVDA (laptop) and TalkBack (mobile).
          </p>
          <a href="https://repository.ukdw.ac.id/7746/" target="_blank" rel="noopener noreferrer" aria-label="View thesis on UKDW repository" class="inline-flex items-center gap-2 text-sm font-medium text-black hover:text-ppink transition-colors mt-2">
            <Icon name="2" class="text-base" aria-hidden="true" />
            View Thesis
          </a>
        </details>
      </div>
    </div>
  </div>
</section>
