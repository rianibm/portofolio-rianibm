---
import { Icon } from "astro-icon/components";

interface Item {
  title: string;
  description?: string;
  label?: string;
  icon?: string;
}
interface Props {
  items: Item[];
  kind?: "cards" | "flow";
  label: string;
  caption?: string;
}
const { items, kind = "cards", label, caption } = Astro.props;
---

<figure class="case-visual not-prose" aria-label={label}>
  {kind === "flow" ? (
    <ol class="flow" style={`--step-count: ${items.length}`}>
      {items.map((item) => <li><span>{item.title}</span>{item.description && <p>{item.description}</p>}</li>)}
    </ol>
  ) : (
    <div class="cards">
      {items.map((item, index) => (
        <section class="card">
          <div class="icon-column" aria-hidden="true"><span class="badge"><Icon name={item.icon ?? "solar:widget-2-linear"} width={32} height={32} /><span>{String(index + 1).padStart(2, "0")}</span></span></div>
          <div class="copy">
            {item.label && <p class="eyebrow">{item.label}</p>}
            <h3>{item.title}</h3>
            {item.description && <p>{item.description}</p>}
          </div>
        </section>
      ))}
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .case-visual { --blue: #006ba8; --border: #cbeafb; margin: 2rem 0; color: #17243d; }
  .cards { display: grid; gap: 1rem; }
  .card { display: grid; grid-template-columns: 4.75rem minmax(0, 1fr); padding: 1.25rem; border: 1px solid var(--border); border-radius: 0.875rem; background: white; box-shadow: 0 4px 24px rgb(0 117 184 / 4%); }
  .icon-column { border-right: 1px solid var(--border); padding-right: 1rem; }
  .badge { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.25rem; width: 3.75rem; height: 3.75rem; border-radius: 50%; background: #eaf7fd; color: var(--blue); font-size: 0.6875rem; font-weight: 750; }
  .copy { padding-left: 1.25rem; }
  .eyebrow { margin: 0 0 0.375rem; color: var(--blue); font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.065em; line-height: 1.5; text-transform: uppercase; }
  h3 { margin: 0; font-size: 1.125rem; font-weight: 750; line-height: 1.4; }
  .copy > p:not(.eyebrow), .flow p { margin: 0.75rem 0 0; color: #596579; font-size: 0.875rem; line-height: 1.7; }
  .flow { display: grid; gap: 2rem; margin: 0; padding: 0; list-style: none; }
  .flow li { position: relative; padding: 1.25rem; border: 1px solid #80caff; border-radius: 1rem; background: #eaf7ff; color: var(--blue); font-size: 0.9375rem; font-weight: 650; line-height: 1.5; text-align: left; }
  .flow p { font-weight: 400; }
  .flow li + li::before { content: ""; position: absolute; bottom: calc(100% + 0.5rem); left: calc(50% - 4px); width: 8px; height: 8px; border-right: 1.5px solid #80caff; border-bottom: 1.5px solid #80caff; transform: rotate(45deg); }
  figcaption { margin-top: 1rem; color: #596579; font-size: 0.8125rem; line-height: 1.6; }
  @media (min-width: 1024px) {
    .case-visual { width: min(calc(100vw - 5rem), 67rem); margin-left: 0; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .flow { grid-template-columns: repeat(var(--step-count), minmax(0, 1fr)); gap: 1.5rem; }
    .flow li + li::before { left: -1rem; bottom: calc(50% - 4px); transform: rotate(-45deg); }
  }
  @media (max-width: 479px) {
    .card { grid-template-columns: 3.25rem minmax(0, 1fr); padding: 1rem; }
    .badge { width: 2.75rem; height: 2.75rem; font-size: 0.625rem; }
    .badge :global(svg) { width: 1.375rem; height: 1.375rem; }
    .copy { padding-left: 0.875rem; }
    h3 { font-size: 1rem; }
  }
</style>
