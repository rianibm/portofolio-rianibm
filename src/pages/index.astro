---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Hero from "@/components/Hero.astro";
import WhatIDo from "@/components/WhatIDo.astro";
import HowIWork from "@/components/HowIWork.astro";
import EnterpriseStrip from "@/components/EnterpriseStrip.astro";
import Skills from "@/components/Skills.astro";
import Education from "@/components/Education.astro";
import LookingFor from "@/components/LookingFor.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="p-0 m-0 max-w-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="container mx-auto px-6 md:px-10">
      <Hero />
      <WhatIDo compact />
      <HowIWork />
      <EnterpriseStrip />
      <Skills />
      <Education />
      <LookingFor />
    </main>
    <Footer />
  </body>
</html>
