---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { Icon } from "astro-icon/components";
import { getSkillClass as _getSkillClass, calcYearsExp } from "@/utils/helpers";

import avatarAvif from "@/assets/images/avatar/about.avif";
import avatarWebp from "@/assets/images/avatar/about.webp";
import avatarPng from "@/assets/images/avatar/about.png";

const title = "About Riani BM";
const description =
  "About Riani BM — UX Engineer based in Jakarta, Indonesia, working at the intersection of UX design and frontend engineering.";

const yearsExp = calcYearsExp(new Date("2023-03-05"));

const skillBgClasses = [
  "bg-pgreen rounded-xl",
  "bg-pblue rounded-xl",
  "bg-ppink rounded-xl",
  "bg-pyellow rounded-xl",
];

const getSkillClass = (i: number) => _getSkillClass(i, skillBgClasses);

const aboutSkills = [
  {
    category: "Design",
    icon: "2",
    description: "I work through the steps, labels, and interactions that help people find their way.",
    skills: ["Figma", "UI Systems", "Accessibility"],
  },
  {
    category: "Engineering",
    icon: "1",
    description: "I turn designs into working screens, connect the data, and take care of the states in between.",
    skills: [
      "React",
      "Next.js",
      "TypeScript",
      "Tailwind CSS",
      "REST APIs",
    ],
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <meta
      name="keywords"
      content="Rianibm, Riani BM, UX Engineer, Frontend Developer, Portfolio, React, Laravel, Tailwind, UI/UX"
    />
    <meta name="author" content="Rianibm" />
    <meta
      name="google-site-verification"
      content="RCc1MVKPhX5dC6D2cAtvSUNTKVPZemBb-O5jEo7czuY"
    />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1" class="container mx-auto px-6 md:px-10">
      <article>
        <a
          href="/"
          aria-label="Go back to homepage"
          class="inline-block px-6 py-3 bg-pgreen text-black rounded-lg font-semibold text-sm hover:shadow-hover transition-all duration-200 border border-black"
        >
          Back to Home
        </a>
        <!-- Photo + Title -->
        <div
          class="flex flex-col items-center pt-12 md:pt-20 pb-10 md:pb-16 gap-4"
          transition:animate="fade"
        >
          <p class="text-sm font-semibold uppercase tracking-widest">About</p>
          <div
            class="w-36 h-36 md:w-48 md:h-48 rounded-full overflow-hidden border-4 border-black shadow-card settle"
          >
            <picture>
              <source srcset={avatarAvif.src} type="image/avif" />
              <source srcset={avatarWebp.src} type="image/webp" />
              <img
                src={avatarPng.src}
                alt="Riani BM"
                class="w-full h-full object-cover"
                width={avatarPng.width}
                height={avatarPng.height}
                loading="eager"
              />
            </picture>
          </div>
          <h1 class="text-3xl md:text-5xl font-semibold text-center">
            <span class="font-kablamo text-ppink">UX</span> Engineer
          </h1>
          <p class="text-pblack text-center text-lg md:text-xl max-w-xl leading-relaxed">
            I’m happiest working through a tricky flow,<br class="hidden sm:block" /> then figuring out how to build it.
          </p>
          <p class="text-sm text-pblack">Riani BM · Based in Indonesia</p>
          <ul aria-label="Experience and delivery highlights" class="grid grid-cols-1 sm:grid-cols-3 w-full max-w-3xl mt-4 border-y border-black/20 divide-y sm:divide-y-0 sm:divide-x divide-black/20 text-center">
            <li class="px-4 py-5">
              <strong class="block text-xl md:text-2xl">{yearsExp}+ years</strong>
              <span class="block text-sm font-semibold text-pblack mt-2">UX + Frontend</span>
            </li>
            <li class="px-4 py-5">
              <strong class="block text-xl md:text-2xl">9 core flows</strong>
              <span class="block text-sm font-semibold text-pblack mt-2">Redesigned &amp; shipped</span>
            </li>
            <li class="px-4 py-5">
              <strong class="block text-xl md:text-2xl">Product Team Lead</strong>
              <span class="block text-sm font-semibold text-pblack mt-2">UX + Frontend</span>
            </li>
          </ul>
        </div>

        <div class="text-black max-w-3xl mx-auto">
          <div class="flex flex-col">
            <!-- What I Do -->
            <section
              class="flex flex-col gap-3 animate-on-scroll from-bottom bg-white rounded-xl p-6"
            >
              <h2 class="section-label">What I Do
              </h2>
              <p class="text-2xl md:text-3xl font-semibold leading-snug max-w-xl">
                A lot of my work starts with: “Wait, what happens next?”
              </p>
              <ul class="space-y-4 mt-2">
                <li><strong class="block">Make complex tasks usable</strong><span class="text-pblack">I work on dashboards, shipping flows, and screens full of data. There’s always a person trying to get something done on the other side.</span></li>
                <li><strong class="block">Ask the extra question</strong><span class="text-pblack">I work through the rules with the team, then turn them into steps and screens we can build.</span></li>
                <li><strong class="block">Stay with it through the build</strong><span class="text-pblack">I write frontend code too, so I get to care about the design all the way down to its loading states.</span></li>
              </ul>
            </section>

            <div class="section-divider" aria-hidden="true"><span></span></div>

            <!-- Career narrative; role history stays available without dominating the page. -->
            <section class="flex flex-col gap-4 animate-on-scroll from-bottom p-6">
              <h2 class="section-label">My Path</h2>
              <p class="text-2xl md:text-4xl font-semibold leading-tight max-w-xl">I started with code. The questions got bigger.</p>
              <p class="text-pblack leading-relaxed max-w-xl">Building interfaces made me curious about the decisions behind them. Why this flow? Why that label? That curiosity brought me further into UX, and eventually into leading a product team.</p>
              <ol class="career-path">
                <li><h3 class="font-semibold text-lg">Frontend Engineering</h3><p class="text-sm text-pblack mt-1">Built production interfaces, operational dashboards, and reusable components.</p></li>
                <li><h3 class="font-semibold text-lg">UX / Product</h3><p class="text-sm text-pblack mt-1">Connected implementation with user needs, business rules, and interaction design.</p></li>
                <li><h3 class="font-semibold text-lg">Product Team Lead</h3><p class="text-sm text-pblack mt-1">Now lead a UI/UX designer and two frontend developers across complex products.</p></li>
              </ol>
              <details class="rounded-lg border border-black p-4 mt-2">
                <summary class="cursor-pointer font-semibold text-sm">Experience details · Indomaret Group</summary>
                <p class="text-xs text-pblack mt-3">PT Indomarco Prismatama (Indomaret Group)</p>
                <div class="space-y-4 mt-4">
                  <div><h3 class="font-semibold">Product Team Lead</h3><p class="text-xs text-pblack">Apr 2026 – Present</p><p class="text-sm mt-1">Lead a team of 1 UI/UX designer and 2 frontend developers while staying hands-on in UX and frontend delivery. Current work spans the Indopaket website revamp, affiliate interfaces, and the Package Claim platform.</p></div>
                  <div><h3 class="font-semibold">Frontend Developer</h3><p class="text-xs text-pblack">Jul 2024 – Mar 2026</p><p class="text-sm mt-1">Built and maintained interfaces and design systems for logistics, membership, affiliate platforms, and internal tools using React and Next.js.</p></div>
                  <div><h3 class="font-semibold">Management Development Program Specialist IT</h3><p class="text-xs text-pblack">Jun 2023 – Jun 2024</p><p class="text-sm mt-1">Used competitor analysis, Hotjar, Google Analytics, and A/B testing to improve web and mobile experiences, translating UI designs into code.</p></div>
                </div>
              </details>
            </section>

            <div class="section-divider" aria-hidden="true"><span></span></div>

            <section class="flex flex-col gap-4 animate-on-scroll from-bottom p-6">
              <h2 class="section-label">How I Work</h2>
              <p>I like understanding why something is difficult before jumping into a solution. Talking it through with the people using and building it is a good place to start.</p>
              <dl class="grid sm:grid-cols-2 gap-6">
                <div><dt class="font-semibold">Systems thinking</dt><dd class="text-sm text-pblack mt-1">I zoom out to see how the steps connect, then zoom back in on the label or state that might trip someone up.</dd></div>
                <div><dt class="font-semibold">UX-to-code</dt><dd class="text-sm text-pblack mt-1">I carry the design into the components, with a little care for the next person who has to change them.</dd></div>
                <div><dt class="font-semibold">Cross-functional</dt><dd class="text-sm text-pblack mt-1">I like talking a decision through with product, design, and engineering. Each person tends to spot a different missing piece.</dd></div>
                <div><dt class="font-semibold">Accessibility</dt><dd class="text-sm text-pblack mt-1">I pay attention to readable structure, useful feedback, and how people find their way through an interaction.</dd></div>
              </dl>
            </section>

            <div class="section-divider" aria-hidden="true"><span></span></div>

            <!-- Technologies Used -->
            <section
              class="flex flex-col gap-3 animate-on-scroll from-bottom p-6"
            >
              <h2 class="section-label">Technology
              </h2>
              <p>
                The tools I use to turn design decisions into working products.
              </p>

              <div class="grid sm:grid-cols-2 gap-4">
                {
                  aboutSkills.map((skillGroup, i) => {
                    const skillClass = getSkillClass(i);
                    return (
                      <div
                        class="border border-black rounded-lg p-3 shadow-card hover:shadow-hover transition-all duration-200 animate-on-scroll from-bottom"
                        style={`--delay: ${i * 0.1}s`}
                      >
                        <div class="flex items-center gap-2 mb-1">
                          <div
                            class={`${skillClass} p-1 border border-black shadow-card1 text-sm`}
                          >
                            <Icon name={skillGroup.icon} aria-hidden="true" />
                          </div>
                          <div class="font-semibold text-sm">
                            {skillGroup.category}
                          </div>
                        </div>
                        <p class="text-sm text-pblack mb-3">{skillGroup.description}</p>
                        <ul class="flex flex-wrap gap-1">
                          {skillGroup.skills.map((skill) => (
                            <li class="px-2 py-1 bg-gray-100 text-gray-700 rounded-full text-xs border border-gray-300">
                              {skill}
                            </li>
                          ))}
                        </ul>
                      </div>
                    );
                  })
                }
              </div>
            </section>

            <div class="section-divider" aria-hidden="true"><span></span></div>

            <!-- Education -->
            <section
              class="flex flex-col gap-2 animate-on-scroll from-bottom p-6"
            >
              <h2 class="section-label">Education
              </h2>
              <p class="font-semibold">
                B.Sc. Informatics
                <span class="font-normal text-pblack">— Duta Wacana Christian University</span>
              </p>
              <details class="group">
                <summary class="cursor-pointer text-sm font-semibold text-black underline underline-offset-4 list-none">
                  Thesis: Inclusive Design for Website-Based Learning →
                </summary>
                <p class="text-sm text-pblack leading-relaxed mt-2">
                  For my thesis, I designed and built an e-learning platform for people with contrast or light sensitivity, low vision, and blindness. I used rapid ethnography and in-depth interviews, then tested accessibility with NVDA on a laptop and TalkBack on mobile.
                </p>
                <a
                  href="https://repository.ukdw.ac.id/7746/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="View thesis on UKDW repository"
                  class="inline-flex items-center gap-2 text-sm font-medium text-black hover:text-ppink transition-colors mt-2"
                >
                  View Thesis
                </a>
              </details>
            </section>

            <div class="section-divider" aria-hidden="true"><span></span></div>

            <!-- For fun -->
            <section
              class="flex flex-col gap-3 animate-on-scroll from-bottom p-6"
            >
              <h2 class="section-label">A Bit More About Me
              </h2>
              <p class="text-sm text-pblack">
                Away from the screen, you’ll probably find me
                doing one of these:
              </p>
              <ul class="flex flex-wrap gap-2">
                <li class="flex items-center gap-2 px-3 py-2 bg-pgreen rounded-full border-1 border-black text-sm font-medium">
                  <span aria-hidden="true">📷</span> Photography
                </li>
                <li class="flex items-center gap-2 px-3 py-2 bg-pblue rounded-full border-1 border-black text-sm font-medium">
                  <span aria-hidden="true">📚</span> Reading novels
                </li>
                <li class="flex items-center gap-2 px-3 py-2 bg-ppink rounded-full border-1 border-black text-sm font-medium">
                  <span aria-hidden="true">🎬</span> Films & shows
                </li>
                <li class="flex items-center gap-2 px-3 py-2 bg-pyellow rounded-full border-1 border-black text-sm font-medium">
                  <span aria-hidden="true">🎵</span> Vinyl records
                </li>
                <li class="flex items-center gap-2 px-3 py-2 bg-white rounded-full border-1 border-black text-sm font-medium">
                  <span aria-hidden="true">🚲🌅</span> Cycling & sunrise-chasing
                </li>
              </ul>
            </section>

            <div class="section-divider" aria-hidden="true"><span></span></div>

            <div class="flex flex-wrap items-center gap-4 p-6">
              <a href="/works" class="inline-flex items-center gap-3 px-5 py-3 bg-pgreen border border-black rounded-lg font-semibold shadow-card hover:shadow-hover transition-shadow">View my work <span aria-hidden="true">→</span></a>
              <a href="mailto:rianimatialu@gmail.com" class="inline-flex items-center gap-3 px-5 py-3 border border-black rounded-lg font-semibold hover:bg-pblue transition-colors">Say hello <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </article>
    </main>
    <Footer />
    <style>
      .section-label {
        font-size: 0.875rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .career-path { list-style: none; padding: 0; margin: 1.5rem 0 0; }
      .career-path li { position: relative; padding: 0 0 2.25rem 1.75rem; border-left: 2px solid var(--color-pblue); }
      .career-path li::before { content: ""; position: absolute; left: -7px; top: 0.4rem; width: 12px; height: 12px; border: 1px solid black; border-radius: 50%; background: var(--color-pblue); }
      .career-path li:not(:last-child)::after { content: "↓"; position: absolute; left: 1.75rem; bottom: 0.35rem; color: var(--color-pblack); }
      .career-path li:last-child { padding-bottom: 0; border-color: transparent; }
      .career-path li:last-child::before { background: var(--color-pgreen); }
      .section-divider { padding: 1rem 1.5rem; }
      .section-divider span { display: block; height: 1px; background: var(--color-pblack); opacity: 0.2; }
    </style>
  </body>
</html>
